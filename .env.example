NODE_ENV=development
PORT=3000

# Main database (created by docker compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN="1h"
BCRYPT_ROUNDS=12

# Used by `npm run db:seed` to create the first admin account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
